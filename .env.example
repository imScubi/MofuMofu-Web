# Supabase (ver panel del proyecto > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Panel de administración
ADMIN_PASSWORD=cambia-esta-contrasena

# Correo del folio (Resend — https://resend.com)
# Sin esto el registro funciona igual, sólo que nadie recibe su folio
# por correo. La dirección de EMAIL_FROM tiene que estar en un dominio
# verificado en Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=MofuMofu Market <hola@mofumofumarket.com>
